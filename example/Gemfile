source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exact versions of the iOS build tooling (never shipped in the app). The React Native template's
# old pins (concurrent-ruby < 1.3.4, xcodeproj < 1.26) locked in versions with known advisories.
gem 'cocoapods', '1.17.0'
gem 'xcodeproj', '1.28.1'
# Newest CocoaPods allows (cocoapods-core: activesupport < 8). GHSA-8474-xrp6-wh69 is fixed only in
# 8.0.5.2+, so it stays open until CocoaPods allows 8 — reviewed exception in osv-scanner.toml.
gem 'activesupport', '7.2.4'
gem 'concurrent-ruby', '1.3.8'    # >= 1.3.7: GHSA-h8w8-99g7-qmvj, GHSA-6wx8-w4f5-wwcr, GHSA-wv3x-4vxv-whpp

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
