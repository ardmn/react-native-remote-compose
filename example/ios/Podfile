# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Prebuilt React Native core and dependencies: much faster builds, and the same pods locally and
# in CI (a Podfile.lock made without them does not match one made with them).
ENV['RCT_USE_RN_DEP'] ||= '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RemoteComposeExample' do
  config = use_native_modules!

  # The library's XCTest unit tests (scheme RemoteCompose-Unit-Tests). Autolinking already adds the
  # pod; this only adds its test spec.
  pod 'RemoteCompose', :path => '../..', :testspecs => ['Tests']

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # React Native's spm_dependency builds RemoteCompose straight into the shared products dir and
    # rewrites the app's references to its module map, but not those of the pod's test spec.
    test_xcconfigs = File.join(installer.sandbox.target_support_files_root, 'RemoteCompose', '*.unit-tests.*.xcconfig')
    Dir.glob(test_xcconfigs).each do |path|
      text = File.read(path)
      fixed = text.gsub('${PODS_CONFIGURATION_BUILD_DIR}/RemoteCompose/RemoteCompose.modulemap',
                        '${PODS_CONFIGURATION_BUILD_DIR}/RemoteCompose.modulemap')
      File.write(path, fixed) unless fixed == text
    end
  end
end
