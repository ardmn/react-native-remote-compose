{
  "header": {
    "width": 360,
    "height": 220,
    "contentDescription": "Product card",
    "apiLevel": 8,
    "densityBehavior": 2,
    "profiles": 513
  },
  "root": {
    "global": [
      {
        "resources": {
          "colors": [
            {
              "accent": "#FF6750A4"
            },
            {
              "onAccent": "#FFFFFFFF"
            }
          ],
          "variables": [
            {
              "count": {
                "value": 0,
                "export": true
              }
            },
            {
              "rating": {
                "value": 0.8,
                "export": true
              }
            },
            {
              "pressed": {
                "value": 0,
                "export": false
              }
            },
            {
              "releasedAt": {
                "value": -10,
                "export": false
              }
            }
          ]
        }
      },
      {
        "variable": {
          "name": "title",
          "vtype": "string",
          "value": "Flat white",
          "export": true
        }
      },
      {
        "variable": {
          "name": "subtitle",
          "vtype": "string",
          "value": "Double ristretto, steamed milk",
          "export": true
        }
      },
      {
        "column": {
          "modifiers": [
            "fillMaxSize",
            {
              "background": "#FFF7F2FA"
            },
            {
              "padding": 16
            }
          ],
          "children": [
            {
              "text": {
                "value": "@title",
                "fontSize": 22,
                "fontWeight": 700,
                "color": "#FF1D1B20",
                "modifiers": [
                  {
                    "animationSpec": 0
                  }
                ]
              }
            },
            {
              "text": {
                "value": "@subtitle",
                "fontSize": 14,
                "color": "#FF49454F",
                "maxLines": 1,
                "overflow": "ellipsis",
                "modifiers": [
                  {
                    "animationSpec": 0
                  }
                ]
              }
            },
            {
              "spacer": {
                "modifiers": [
                  {
                    "height": 12
                  }
                ]
              }
            },
            {
              "box": {
                "modifiers": [
                  "fillMaxWidth",
                  {
                    "height": 8
                  },
                  {
                    "background": "#FFE8DEF8"
                  }
                ],
                "children": [
                  {
                    "box": {
                      "modifiers": [
                        {
                          "width": "@rating * 328"
                        },
                        {
                          "height": 8
                        },
                        {
                          "background": "$colors.accent"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "spacer": {
                "modifiers": [
                  {
                    "height": 16
                  }
                ]
              }
            },
            {
              "row": {
                "modifiers": [
                  "fillMaxWidth"
                ],
                "verticalAlignment": "center",
                "children": [
                  {
                    "box": {
                      "modifiers": [
                        {
                          "size": [
                            140,
                            44
                          ]
                        },
                        {
                          "graphicsLayer": {
                            "scaleX": "1 - 0.05 * max(@pressed, clamp(1 - (time - @releasedAt) / 0.22, 0, 1))",
                            "scaleY": "1 - 0.05 * max(@pressed, clamp(1 - (time - @releasedAt) / 0.22, 0, 1))",
                            "alpha": "1 - 0.2 * max(@pressed, clamp(1 - (time - @releasedAt) / 0.22, 0, 1))"
                          }
                        },
                        {
                          "clip": {
                            "roundRect": 22
                          }
                        },
                        {
                          "background": "$colors.accent"
                        },
                        {
                          "onTouchDown": {
                            "type": "valueFloatChange",
                            "target": "@pressed",
                            "value": 1
                          }
                        },
                        {
                          "onTouchUp": [
                            {
                              "type": "valueFloatChange",
                              "target": "@pressed",
                              "value": 0
                            },
                            {
                              "type": "valueFloatExpressionChange",
                              "target": "@releasedAt",
                              "value": "time + 0"
                            }
                          ]
                        },
                        {
                          "onTouchCancel": [
                            {
                              "type": "valueFloatChange",
                              "target": "@pressed",
                              "value": 0
                            },
                            {
                              "type": "valueFloatExpressionChange",
                              "target": "@releasedAt",
                              "value": "time + 0"
                            }
                          ]
                        },
                        {
                          "onClick": {
                            "type": "hostAction",
                            "name": "add_to_cart"
                          }
                        },
                        {
                          "multiClick": {
                            "clickType": 1,
                            "actions": {
                              "type": "hostAction",
                              "name": "show_details"
                            }
                          }
                        }
                      ],
                      "horizontalAlignment": "center",
                      "verticalAlignment": "center",
                      "children": [
                        {
                          "text": {
                            "value": "Add to cart",
                            "fontSize": 16,
                            "color": "$colors.onAccent"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "spacer": {
                      "modifiers": [
                        {
                          "width": 16
                        }
                      ]
                    }
                  },
                  {
                    "text": {
                      "textFromFloat": {
                        "value": "@count",
                        "whole": 3,
                        "decimal": 0
                      },
                      "fontSize": 18,
                      "color": "#FF1D1B20",
                      "modifiers": [
                        {
                          "animationSpec": 0
                        }
                      ]
                    }
                  },
                  {
                    "text": {
                      "value": " in cart",
                      "fontSize": 18,
                      "color": "#FF1D1B20",
                      "modifiers": [
                        {
                          "animationSpec": 0
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
