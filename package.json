{
  "name": "react-native-remote-compose",
  "version": "0.1.1",
  "description": "Play Remote Compose (.rc) documents in React Native on Android and iOS, with host actions and named values",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-remote-compose-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "plugin",
    "app.plugin.js",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/src/test",
    "!ios/Tests",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-remote-compose-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc && tsc -p example && tsc -p example-expo",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "measure:size": "node scripts/measure-size.ts",
    "measure:perf": "node scripts/measure-perf.ts",
    "documents": "node scripts/convert-documents.ts",
    "contract": "node scripts/generate-native-contract.ts",
    "test:scripts": "node --test \"scripts/__tests__/*.test.ts\""
  },
  "keywords": [
    "react-native",
    "expo",
    "android",
    "ios",
    "remote-compose",
    "compose",
    "jetpack-compose",
    "compose-multiplatform",
    "rc-players",
    "server-driven-ui",
    "fabric",
    "new-architecture",
    "remote-compose-player",
    "server-driven",
    "sdui",
    "androidx",
    "dynamic-ui",
    "react-native-component",
    "expo-plugin",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardmn/react-native-remote-compose.git"
  },
  "author": "Ardmn <artiom999@gmail.com> (https://github.com/ardmn)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ardmn/react-native-remote-compose/issues"
  },
  "homepage": "https://github.com/ardmn/react-native-remote-compose#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/codegen": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/cross-spawn": "6.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "cross-spawn": "7.0.6",
    "del-cli": "8.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ft-flow": "3.0.11",
    "eslint-plugin-prettier": "5.5.7",
    "expo": "58.0.25",
    "jest": "30.5.2",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "0.44.1",
    "test-renderer": "1.3.1",
    "turbo": "2.11.11",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example",
    "example-expo",
    "example-shared"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RemoteComposeViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.remotecompose"
    },
    "ios": {
      "components": {
        "RemoteComposeView": {
          "className": "RemoteComposeView"
        }
      },
      "modulesProvider": {
        "RemoteComposeModule": "RemoteComposeModule"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/",
      "<rootDir>/example-expo/",
      "<rootDir>/example-shared/",
      "<rootDir>/lib/",
      "<rootDir>/tools/"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)",
      "<rootDir>/plugin/**/__tests__/**/*.test.js"
    ],
    "restoreMocks": true
  }
}
