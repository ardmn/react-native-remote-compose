{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build:android": {
      "env": [
        "ANDROID_HOME"
      ],
      "inputs": [
        "package.json",
        "app.json",
        "metro.config.js",
        "index.js",
        "*.tsx",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "!android/app/.cxx/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/plugin/**",
        "$TURBO_ROOT$/app.plugin.js",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/example-shared/**",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/android/.cxx/**",
        "!$TURBO_ROOT$/android/.gradle/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "app.json",
        "metro.config.js",
        "index.js",
        "*.tsx",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/plugin/**",
        "$TURBO_ROOT$/app.plugin.js",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/example-shared/**",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/ios/**"
      ],
      "outputs": []
    }
  }
}
