{
  "expo": {
    "name": "RemoteComposeExpo",
    "slug": "remote-compose-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.ardmn.remotecompose.expo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.ardmn.remotecompose.expo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "rcdemo",
    "plugins": [
      "react-native-remote-compose"
    ],
    "extra": {
      "eas": {
        "projectId": "bda85786-d0fb-42a2-b869-7b2727706318"
      }
    },
    "owner": "ardmn"
  }
}
